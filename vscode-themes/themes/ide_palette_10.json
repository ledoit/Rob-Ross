    "list.activeSelectionBackground": "#46DCF666",
    "list.inactiveSelectionBackground": "#46DCF633",
    "list.hoverBackground": "#46DCF644",
    "list.activeSelectionForeground": "#F6F8F8",
    "list.inactiveSelectionForeground": "#F6F8F8",
    "list.focusBackground": "#46DCF666",
    "list.focusForeground": "#F6F8F8",
    "list.highlightForeground": "#46DCF6",
    "editorWidget.background": "#1A2428",
    "editorWidget.foreground": "#F6F8F8",
    "editorWidget.border": "#3E637E",
    "editorHoverWidget.background": "#1A2428",
    "editorHoverWidget.foreground": "#F6F8F8",
    "editorHoverWidget.border": "#3E637E66",
    "editorSuggestWidget.background": "#1A2428",
    "editorSuggestWidget.foreground": "#F6F8F8",
    "editorSuggestWidget.border": "#3E637E",
    "editorSuggestWidget.selectedBackground": "#46DCF666",
    "sideBar.border": "#3E637E44",
    "sideBarSectionHeader.background": "#0D1112",
    "sideBarSectionHeader.foreground": "#F6F8F8",
    "sideBarTitle.foreground": "#F6F8F8",
    "tab.inactiveBackground": "#0D1112",
    "tab.activeBackground": "#1A2428",
    "tab.inactiveForeground": "#3E637E",
    "tab.activeForeground": "#F6F8F8",
    "tab.border": "#0D1112",
    "editorGroupHeader.tabsBackground": "#0D1112",
    "editorGroup.border": "#3E637E44",
    "badge.background": "#46DCF6",
    "badge.foreground": "#0D1112",
    "selection.background": "#46DCF655",
    "pickerGroup.foreground": "#46DCF6",
    "pickerGroup.border": "#3E637E66"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3E637E"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#EFC48F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E9F674"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#F688EF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EE9768"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#F6F8F8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#F37790"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#64F26E"
      }
    },
    {
      "scope": [
        "support.class.component.js",
        "entity.name.type.class.ts"
      ],
      "settings": {
        "foreground": "#F37790"
      }
    },
    {
      "scope": [
        "entity.name.type.module.js",
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#EFC48F"
      }
    },
    {
      "scope": [
        "storage.type.function.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#E9F674"
      }
    },
    {
      "scope": [
        "support.type.python",
        "entity.name.class.python"
      ],
      "settings": {
        "foreground": "#F37790"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#387FF0"
      }
    },
    {
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#EFC48F"
      }
    },
    {
      "scope": [
        "markup.heading.markdown",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#46DCF6"
      }
    },
    {
      "scope": [
        "markup.italic.markdown",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#F688EF"
      }
    },
    {
      "scope": [
        "support.function.builtin.shell",
        "keyword.operator.pipe.shell"
      ],
      "settings": {
        "foreground": "#E9F674"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell"
      ],
      "settings": {
        "foreground": "#F37790"
      }
    }
  ]
}