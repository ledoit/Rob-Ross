    "activityBar.background": "#FFFAD1",
    "activityBar.foreground": "#361F4F",
    "statusBar.background": "#FFFAE5",
    "statusBar.foreground": "#361F4F",
    "titleBar.activeBackground": "#FFFAD1",
    "titleBar.activeForeground": "#361F4F",
    "panel.background": "#FFFAE5",
    "panel.border": "#7A6A1E",
    "terminal.background": "#FFFACD",
    "terminal.foreground": "#361F4F",
    "terminal.ansiBlue": "#FFD700",
    "terminal.ansiMagenta": "#8B6914",
    "terminal.ansiGreen": "#00695C",
    "terminal.ansiRed": "#B71C1C",
    "terminal.ansiYellow": "#7B4FAD",
    "focusBorder": "#FFD700",
    "button.background": "#FFD700",
    "button.foreground": "#FFFACD",
    "button.hoverBackground": "#8B6914",
    "input.foreground": "#361F4F",
    "input.placeholderForeground": "#7A6A1E",
    "input.border": "#7A6A1E88",
    "dropdown.background": "#FFFAE5",
    "dropdown.foreground": "#361F4F",
    "dropdown.border": "#7A6A1E44",
    "quickInput.background": "#FFFAE5",
    "quickInput.foreground": "#361F4F",
    "quickInputList.focusBackground": "#8B691488",
    "list.activeSelectionBackground": "#8B691466",
    "list.inactiveSelectionBackground": "#8B691433",
    "list.hoverBackground": "#8B691444",
    "list.activeSelectionForeground": "#361F4F",
    "list.inactiveSelectionForeground": "#361F4F",
    "list.focusBackground": "#8B691466",
    "list.focusForeground": "#361F4F",
    "list.highlightForeground": "#FFD700",
    "editorWidget.background": "#FFFAE5",
    "editorWidget.foreground": "#361F4F",
    "editorWidget.border": "#7A6A1E",
    "editorHoverWidget.background": "#FFFAE5",
    "editorHoverWidget.foreground": "#361F4F",
    "editorHoverWidget.border": "#7A6A1E66",
    "editorSuggestWidget.background": "#FFFAE5",
    "editorSuggestWidget.foreground": "#361F4F",
    "editorSuggestWidget.border": "#7A6A1E",
    "editorSuggestWidget.selectedBackground": "#8B691466",
    "sideBar.border": "#7A6A1E44",
    "sideBarSectionHeader.background": "#FFFAD1",
    "sideBarSectionHeader.foreground": "#361F4F",
    "sideBarTitle.foreground": "#361F4F",
    "tab.inactiveBackground": "#FFFAD1",
    "tab.activeBackground": "#FFFAE5",
    "tab.inactiveForeground": "#7A6A1E",
    "tab.activeForeground": "#361F4F",
    "tab.border": "#FFFAD1",
    "editorGroupHeader.tabsBackground": "#FFFAD1",
    "editorGroup.border": "#7A6A1E44",
    "badge.background": "#FFD700",
    "badge.foreground": "#FFFACD",
    "selection.background": "#8B691455",
    "pickerGroup.foreground": "#FFD700",
    "pickerGroup.border": "#7A6A1E66"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A6A1E"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5E35B1"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8B6914"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#00695C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#7B4FAD"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#361F4F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B71C1C"
      }
    },
    {
      "scope": [
        "support.class.component.js",
        "entity.name.type.class.ts"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    },
    {
      "scope": [
        "entity.name.type.module.js",
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#5E35B1"
      }
    },
    {
      "scope": [
        "storage.type.function.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#8B6914"
      }
    },
    {
      "scope": [
        "support.type.python",
        "entity.name.class.python"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8B6914"
      }
    },
    {
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#5E35B1"
      }
    },
    {
      "scope": [
        "markup.heading.markdown",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "scope": [
        "markup.italic.markdown",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#00695C"
      }
    },
    {
      "scope": [
        "support.function.builtin.shell",
        "keyword.operator.pipe.shell"
      ],
      "settings": {
        "foreground": "#8B6914"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    }
  ]
}