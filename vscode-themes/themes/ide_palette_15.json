    "editor.lineHighlightBackground": "#FFE8F040",
    "editor.selectionBackground": "#FF2D6F35",
    "editor.inactiveSelectionBackground": "#FF85A866",
    "editorIndentGuide.background1": "#FF85A866",
    "editorIndentGuide.activeBackground1": "#E8205088",
    "editorWhitespace.foreground": "#FF85A888",
    "sideBar.background": "#FFF0F5",
    "sideBar.foreground": "#B01040",
    "activityBar.background": "#FFFAFB",
    "activityBar.foreground": "#B01040",
    "statusBar.background": "#FFF0F5",
    "statusBar.foreground": "#B01040",
    "titleBar.activeBackground": "#FFFAFB",
    "titleBar.activeForeground": "#B01040",
    "panel.background": "#FFF0F5",
    "panel.border": "#FF85A8",
    "terminal.background": "#FFF5F8",
    "terminal.foreground": "#B01040",
    "terminal.ansiBlue": "#E82050",
    "terminal.ansiMagenta": "#FF2D6F",
    "terminal.ansiGreen": "#DB2777",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiYellow": "#DC2626",
    "focusBorder": "#E82050",
    "button.background": "#E82050",
    "button.foreground": "#FFF5F8",
    "button.hoverBackground": "#FF2D6F",
    "input.foreground": "#B01040",
    "input.placeholderForeground": "#FF85A8",
    "input.border": "#FF85A888",
    "dropdown.background": "#FFF0F5",
    "dropdown.foreground": "#B01040",
    "dropdown.border": "#FF85A844",
    "quickInput.background": "#FFF0F5",
    "quickInput.foreground": "#B01040",
    "quickInputList.focusBackground": "#FF2D6F88",
    "list.activeSelectionBackground": "#FF2D6F66",
    "list.inactiveSelectionBackground": "#FF2D6F33",
    "list.hoverBackground": "#FF2D6F44",
    "list.activeSelectionForeground": "#B01040",
    "list.inactiveSelectionForeground": "#B01040",
    "list.focusBackground": "#FF2D6F66",
    "list.focusForeground": "#B01040",
    "list.highlightForeground": "#E82050",
    "editorWidget.background": "#FFF0F5",
    "editorWidget.foreground": "#B01040",
    "editorWidget.border": "#FF85A8",
    "editorHoverWidget.background": "#FFF0F5",
    "editorHoverWidget.foreground": "#B01040",
    "editorHoverWidget.border": "#FF85A866",
    "editorSuggestWidget.background": "#FFF0F5",
    "editorSuggestWidget.foreground": "#B01040",
    "editorSuggestWidget.border": "#FF85A8",
    "editorSuggestWidget.selectedBackground": "#FF2D6F66",
    "sideBar.border": "#FF85A844",
    "sideBarSectionHeader.background": "#FFFAFB",
    "sideBarSectionHeader.foreground": "#B01040",
    "sideBarTitle.foreground": "#B01040",
    "tab.inactiveBackground": "#FFFAFB",
    "tab.activeBackground": "#FFF0F5",
    "tab.inactiveForeground": "#FF85A8",
    "tab.activeForeground": "#B01040",
    "tab.border": "#FFFAFB",
    "editorGroupHeader.tabsBackground": "#FFFAFB",
    "editorGroup.border": "#FF85A844",
    "badge.background": "#E82050",
    "badge.foreground": "#FFF5F8",
    "selection.background": "#FF2D6F55",
    "pickerGroup.foreground": "#E82050",
    "pickerGroup.border": "#FF85A866"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#FF85A8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#A11345"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#DB2777"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#DC2626"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#B01040"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "scope": [
        "support.class.component.js",
        "entity.name.type.class.ts"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "scope": [
        "entity.name.type.module.js",
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#A11345"
      }
    },
    {
      "scope": [
        "storage.type.function.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "scope": [
        "support.type.python",
        "entity.name.class.python"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#A11345"
      }
    },
    {
      "scope": [
        "markup.heading.markdown",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#E82050"
      }
    },
    {
      "scope": [
        "markup.italic.markdown",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#DB2777"
      }
    },
    {
      "scope": [
        "support.function.builtin.shell",
        "keyword.operator.pipe.shell"
      ],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    }
  ]
}