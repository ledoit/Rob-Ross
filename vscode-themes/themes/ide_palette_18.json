    "editor.inactiveSelectionBackground": "#5B9CC866",
    "editorIndentGuide.background1": "#5B9CC866",
    "editorIndentGuide.activeBackground1": "#38BDF888",
    "editorWhitespace.foreground": "#5B9CC888",
    "sideBar.background": "#F0F9FF",
