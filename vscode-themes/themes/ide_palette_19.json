    "editorSuggestWidget.background": "#1F222E",
    "editorSuggestWidget.foreground": "#FAFAFA",
    "editorSuggestWidget.border": "#565981",
    "editorSuggestWidget.selectedBackground": "#CB3DFF66",
    "sideBar.border": "#56598144",
