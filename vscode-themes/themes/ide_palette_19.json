    "tab.inactiveForeground": "#565981",
    "tab.activeForeground": "#FAFAFA",
    "tab.border": "#111112",
    "editorGroupHeader.tabsBackground": "#111112",
    "editorGroup.border": "#56598144",
    "badge.background": "#CB3DFF",
